{
  "env": {
    "AWS_PROFILE": "default",
    "AWS_REGION": "us-east-1"
  },
  "permissions": {
    "allow": [
      "Bash(python3:*)",
      "Bash(open:*)",
      "Bash(bash .claude/hooks/pre-tool-guard.sh)",
      "Bash(bash .claude/hooks/post-tool-logger.sh)",
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)"
    ]
  },
  "enabledMcpjsonServers": [
    "terraform",
    "aws"
  ]
}
