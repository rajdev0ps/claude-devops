# Copy this file to backend.hcl and fill in your values.
# backend.hcl is gitignored — never commit real AWS account IDs or bucket names.
#
# Usage:
#   cp backend.hcl.example backend.hcl
#   # then edit backend.hcl with your actual values
#   cd ../../terraform
#   terraform init -backend-config=../environments/dev/backend.hcl

bucket         = "terraform-state-{aws-account-id}-us-east-1"
key            = "petclinic-poc/dev/terraform.tfstate"
region         = "us-east-1"
encrypt        = true
dynamodb_table = "petclinic-poc-terraform-locks"
